# Copy this file to .env and fill in the credentials from the iFlytek console.
# Never expose these values in browser code or commit the resulting .env file.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# Optional private 超拟人 WebAPI endpoint. The server automatically uses the
# standard streaming endpoint for x4_yezi because that voice is not available
# on the private voice families.
XFYUN_TTS_URL=
XFYUN_VOICE=x4_yezi
XFYUN_SPEED=55
XFYUN_VOLUME=65
XFYUN_PITCH=48

PORT=4173
HOST=0.0.0.0
